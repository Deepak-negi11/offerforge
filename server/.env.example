# Copy to .env to configure the API.
PORT=8787

# Set after `docker compose up -d piston && ./scripts/setup-runner.sh` to enable C++ and Java.
# PISTON_URL=http://localhost:2000

# Where the SQLite database lives (default: server/data/atlas.db).
# DB_PATH=./data/atlas.db

# Production only: number of reverse proxies in front of the app, and allowed origins for writes.
# TRUST_PROXY=1
# ALLOWED_ORIGINS=https://offerforge.example.com
