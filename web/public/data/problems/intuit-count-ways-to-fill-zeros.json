^9 + 7. (A per-segment DP over the partial sum also works within n ≤ 1500.)"],"starters":{"python":"import sys\nfrom typing import List\n\n\ndef count_ways(arr: List[int]) -> int:\n    # Write your solution here\n    return 0\n\n\ndef main():\n    data = sys.stdin.read().split()\n    n = int(data[0])\n    arr = [int(x) for x in data[1:1 + n]]\n    print(count_ways(arr))\n\n\nmain()\n","javascript":"function countWays(arr) {\n  // Write your solution here\n  return 0\n}\n\nconst t = input.split(/\\s+/).filter(Boolean).map(Number)\nconst n = t[0]\nconst arr = t.slice(1, 1 + n)\nconsole.log(String(countWays(arr)))\n","cpp":"#include <bits/stdc++.h>\nusing namespace std;\n\nlong long countWays(vector<long long>& arr) {\n    // Write your solution here\n    return 0;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n;\n    cin >> n;\n    vector<long long> arr(n);\n    for (auto& x : arr) cin >> x;\n    cout << countWays(arr) << endl;\n    return 0;\n}\n","java":"import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static long countWays(long[] arr) {\n        // Write your solution here\n        return 0;\n    }\n\n    public static void main(String[] args) throws IOException {\n        StreamTokenizer in = new StreamTokenizer(new BufferedReader(new InputStreamReader(System.in)));\n        in.nextToken();\n        int n = (int) in.nval;\n        long[] arr = new long[n];\n        for (int i = 0; i < n; i++) { in.nextToken(); arr[i] = (long) in.nval; }\n        System.out.println(countWays(arr));\n    }\n}\n"},"reconstructed":true}