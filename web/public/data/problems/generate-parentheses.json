 namespace std;\n\nvector<string> generateParenthesis(int n) {\n    // Write your solution here\n    return {};\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int t;\n    cin >> t;\n    while (t--) {\n        int n;\n        cin >> n;\n        vector<string> res = generateParenthesis(n);\n        sort(res.begin(), res.end());\n        for (size_t i = 0; i < res.size(); i++) cout << res[i] << (i + 1 < res.size() ? ' ' : '\\n');\n        if (res.empty()) cout << '\\n';\n    }\n    return 0;\n}\n","java":"import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static String[] readTokens() throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        StringBuilder sb = new StringBuilder();\n        String line;\n        while ((line = br.readLine()) != null) sb.append(line).append(' ');\n        String text = sb.toString().trim();\n        return text.isEmpty() ? new String[0] : text.split(\"\\\\s+\");\n    }\n\n    static List<String> generateParenthesis(int n) {\n        // Write your solution here\n        return new ArrayList<>();\n    }\n\n    public static void main(String[] args) throws IOException {\n        String[] tk = readTokens();\n        int t = Integer.parseInt(tk[0]);\n        StringBuilder sb = new StringBuilder();\n        for (int i = 0; i < t; i++) {\n            List<String> res = new ArrayList<>(generateParenthesis(Integer.parseInt(tk[1 + i])));\n            Collections.sort(res);\n            sb.append(String.join(\" \", res)).append('\\n');\n        }\n        System.out.print(sb);\n    }\n}\n"},"reconstructed":false,"generator":"def gen(rng):\n    def fmt(ns):\n        return str(len(ns)) + '\\n' + '\\n'.join(map(str, ns))\n    tests = [fmt([n]) for n in range(1, 10)]\n    tests.append(fmt([1, 1, 1]))\n    tests.append(fmt([2, 1, 3]))\n    tests.append(fmt([5, 4, 3, 2, 1]))\n    for _ in range(25):\n        tests.append(fmt([rng.randint(1, 7) for _ in range(rng.randint(1, 5))]))\n    tests.append(fmt([9, 9, 9, 9, 9]))\n    tests.append(fmt([9, 8, 9, 7, 9]))\n    tests.append(fmt([9]))\n    return tests\n","seed":20261020}