ad of which subsets are chosen.","Let reachable[s] mean that some subset of the elements seen so far sums to s. Start with reachable[0] = true.","For each element v, update the sums from high to low (target down to v) so that v is not used twice: reachable[s] |= reachable[s - v]."],"starters":{"python":"import sys\nfrom typing import List\n\n\ndef can_make(nums: List[int], target: int) -> bool:\n    # Write your solution here\n    return False\n\n\ndef main():\n    data = sys.stdin.read().split()\n    n, target = int(data[0]), int(data[1])\n    nums = [int(x) for x in data[2:2 + n]]\n    print('YES' if can_make(nums, target) else 'NO')\n\n\nmain()\n","javascript":"function canMake(nums, target) {\n  // Write your solution here\n  return false\n}\n\nconst t = input.split(/\\s+/).filter(Boolean).map(Number)\nconst n = t[0], target = t[1]\nconst nums = t.slice(2, 2 + n)\nconsole.log(canMake(nums, target) ? 'YES' : 'NO')\n","cpp":"#include <bits/stdc++.h>\nusing namespace std;\n\nbool canMake(vector<int>& nums, int target) {\n    // Write your solution here\n    return false;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, target;\n    cin >> n >> target;\n    vector<int> nums(n);\n    for (int i = 0; i < n; i++) cin >> nums[i];\n    cout << (canMake(nums, target) ? \"YES\" : \"NO\") << endl;\n    return 0;\n}\n","java":"import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static boolean canMake(int[] nums, int target) {\n        // Write your solution here\n        return false;\n    }\n\n    public static void main(String[] args) throws IOException {\n        StreamTokenizer in = new StreamTokenizer(new BufferedReader(new InputStreamReader(System.in)));\n        in.nextToken();\n        int n = (int) in.nval;\n        in.nextToken();\n        int target = (int) in.nval;\n        int[] nums = new int[n];\n        for (int i = 0; i < n; i++) {\n            in.nextToken();\n            nums[i] = (int) in.nval;\n      