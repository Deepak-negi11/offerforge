er)\nconst r = t[0], c = t[1], k = t[2]\nconst grid = []\nfor (let i = 0; i < r; i++) grid.push(t.slice(3 + i * c, 3 + (i + 1) * c))\nconsole.log(shortestPath(grid, k))\n","cpp":"#include <bits/stdc++.h>\nusing namespace std;\n\nint shortestPath(vector<vector<int>>& grid, int k) {\n    // Write your solution here\n    return -1;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int r, c, k;\n    cin >> r >> c >> k;\n    vector<vector<int>> grid(r, vector<int>(c));\n    for (int i = 0; i < r; i++)\n        for (int j = 0; j < c; j++) cin >> grid[i][j];\n    cout << shortestPath(grid, k) << endl;\n    return 0;\n}\n","java":"import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    static int shortestPath(int[][] grid, int k) {\n        // Write your solution here\n        return -1;\n    }\n\n    public static void main(String[] args) throws IOException {\n        StreamTokenizer in = new StreamTokenizer(new BufferedReader(new InputStreamReader(System.in)));\n        in.nextToken();\n        int r = (int) in.nval;\n        in.nextToken();\n        int c = (int) in.nval;\n        in.nextToken();\n        int k = (int) in.nval;\n        int[][] grid = new int[r][c];\n        for (int i = 0; i < r; i++) {\n            for (int j = 0; j < c; j++) {\n                in.nextToken();\n                grid[i][j] = (int) in.nval;\n            }\n        }\n        System.out.println(shortestPath(grid, k));\n    }\n}\n"},"reconstructed":false}